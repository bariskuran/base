{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "allowJs": true,
        "checkJs": false,
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "paths": {
            "base": ["./node_modules/@bariskuran/base"],
            "global": ["./src/global"],
            "global/*": ["./src/global/*"],
            "components": ["./src/components"],
            "components/*": ["./src/components/*"],
            "images": ["./src/images"],
            "images/*": ["./src/images/*"],
            "views": ["./src/views"],
            "views/*": ["./src/views/*"],
            "hooks": ["./src/hooks"],
            "hooks/*": ["./src/hooks/*"],
            "functions": ["./src/functions"],
            "functions/*": ["./src/functions/*"],
            "assets": ["./src/assets"],
            "assets/*": ["./src/assets/*"]
        },
        "typeRoots": ["./node_modules/@types"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
